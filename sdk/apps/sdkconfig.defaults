# Reduce BLE controller RAM usage
CONFIG_BT_CTRL_BLE_MAX_ACT=4

# Keep enough internal heap for WiFi static RX buffers after PSRAM-heavy init
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152

# TLS: free SSL TX/RX buffers when idle to save internal RAM
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# WiFi 缓冲对齐 ct_eye_plush（省内部 DRAM）
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=5
CONFIG_ESP_WIFI_RX_BA_WIN=12
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_ENT_FREE_DYNAMIC_BUFFER=y

# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set

# Debug-only; meminfo CLI loses task run-time stats without this
# CONFIG_FREERTOS_USE_TRACE_FACILITY is not set

# NVS cache in PSRAM saves internal RAM; keep WiFi/LwIP IRAM opts enabled (required for stable WiFi)
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y

# More BSD sockets for MQTT + RTC; one slot reserved by bsp_oss_upload_init()
CONFIG_LWIP_MAX_SOCKETS=12

# YOLO11n-pose in the coco_pose partition. V1 matches ct_eye_plush.
CONFIG_FLASH_COCO_POSE_YOLO11N_POSE_S8_V1=y
CONFIG_FLASH_COCO_POSE_YOLO11N_POSE_S8_V2=n
CONFIG_COCO_POSE_YOLO11N_POSE_S8_V1=y
CONFIG_COCO_POSE_MODEL_IN_FLASH_PARTITION=y

# BF3901 SPI camera (esp_video 2.2.0)
CONFIG_ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_DATA_PREPROCESSING=y
CONFIG_ESP_VIDEO_CHECK_PARAMETERS=y
CONFIG_CAMERA_BF3901=y
CONFIG_CAMERA_BF3901_AUTO_DETECT_SPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_BF3901_SPI_YUV422_240X320_15FPS=y
CONFIG_CAMERA_BF3901_SPI_DEFAULT_FMT_YUV422_240X320_15FPS=y
CONFIG_CAMERA_SENSOR_XCLK_INPUT_24M=y
CONFIG_CAM_CTLR_SPI_ISR_CACHE_SAFE=y
# CONFIG_CAM_CTLR_SPI_DISABLE_BACKUP_BUFFER is not set
# CONFIG_CAM_CTLR_SPI_DISABLE_AUTO_DECODE is not set
CONFIG_CAM_CTLR_SPI_DECODE_TASK_PRIORITY=20
