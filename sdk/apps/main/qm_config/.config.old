CONFIG_QM_SERIAL_ACK_TIMEOUT_MS=500
CONFIG_QM_SERIAL_ID_CHECK_TIMEOUT_MS=500
CONFIG_QM_SERIAL_RECV_TIMEOUT_MS=500
CONFIG_QM_SERIAL_SEND_QUEUE_NUM=20
CONFIG_QM_SERIAL_DOWN_QUEUE_NUM=20
CONFIG_QM_SERIAL_SEND_RETRY_COUNT=1
