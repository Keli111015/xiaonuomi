#
# xjiang serial
#
CONFIG_QM_SERIAL_UART_PORT=1
CONFIG_QM_SERIAL_UART_BAUDRATE=9600
CONFIG_QM_SERIAL_UART_TX_PIN=1
CONFIG_QM_SERIAL_UART_RX_PIN=2
CONFIG_QM_SERIAL_RTOS_SUPPORT=y
CONFIG_QM_SERIAL_RESEND_SUPPORT=y
CONFIG_QM_SERIAL_OTA_SUPPORT=y
CONFIG_QM_SERIAL_RAW_SUPPORT=y
CONFIG_QM_SERIAL_LOWPOWER_SUPPORT=y
CONFIG_QM_SERIAL_HEARTBEAT_NOTIFY_SUPPORT=y
CONFIG_QM_SERIAL_PRINTF_SUPPORT=y
CONFIG_QM_SERIAL_REPORT_NOTIFY_SUPPORT=y
