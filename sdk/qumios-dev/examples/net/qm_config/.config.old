#
# qumios
#
# CONFIG_QM_OS_SUPPORT is not set
CONFIG_QM_NOOS_SUPPORT=y

#
# qmos api support
#
CONFIG_QM_OS_TASK_SUPPORT=y
CONFIG_QM_OS_MUTEX_SUPPORT=y
CONFIG_QM_OS_SEM_SUPPORT=y
CONFIG_QM_OS_QUEUE_SUPPORT=y
CONFIG_QM_OS_EVENT_SUPPORT=y
CONFIG_QM_OS_TIMER_SUPPORT=y
# end of qmos api support

CONFIG_QM_CHECK_SUPPORT=y
CONFIG_QM_CHECK_SILENT=y
CONFIG_QM_TYPE_SUPPORT=y

#
# type config
#
CONFIG_QM_TYPE_BOOL_SUPPORT=y
# CONFIG_QM_TYPE_INT8_SUPPORT is not set
# CONFIG_QM_TYPE_UINT8_SUPPORT is not set
# CONFIG_QM_TYPE_INT16_SUPPORT is not set
# CONFIG_QM_TYPE_UINT16_SUPPORT is not set
# CONFIG_QM_TYPE_INT32_SUPPORT is not set
# CONFIG_QM_TYPE_UINT32_SUPPORT is not set
# CONFIG_QM_TYPE_SIZE_SUPPORT is not set
# CONFIG_QM_TYPE_INT64_SUPPORT is not set
CONFIG_QM_TYPE_FLOAT32_SUPPORT=y
CONFIG_QM_TYPE_FLOAT64_SUPPORT=y
# end of type config

CONFIG_QM_LOG_SUPPORT=y
CONFIG_QM_LOG_UART=y
# CONFIG_QM_LOG_JTAG is not set
# CONFIG_QM_LOG_USB_CDC is not set
CONFIG_QM_DEBUG_UART_PORT=0
CONFIG_QM_DEBUG_UART_BRAUDRATE=115200
CONFIG_QM_DEBUG_UART_TX_PIN=1
CONFIG_QM_DEBUG_UART_RX_PIN=3
CONFIG_LOG_SIMPLE=y
# CONFIG_LOG_DETAILS is not set
# CONFIG_QM_ASSERT is not set
# CONFIG_QM_LOG_PROTECT_SUPPORT is not set
# CONFIG_QM_LOG_HEX_CACHE_SUPPORT is not set
