#
# common light
#
CONFIG_COMMON_LIGHT_TYPE_CW=y
# CONFIG_COMMON_LIGHT_TYPE_RGB is not set
# CONFIG_COMMON_LIGHT_TYPE_CWRGB is not set
CONFIG_COMMON_LIGHT_DRIVER_TYPE_PWM=y
# CONFIG_COMMON_LIGHT_DRIVER_TYPE_I2C is not set
CONFIG_COMMON_LIGHT_FLEX_SWITCH_PIN=0
CONFIG_COMMON_LIGHT_DEFAULT_PWM_FREQ=800
CONFIG_COMMON_LIGHT_PWM_WARM_PIN=4
CONFIG_COMMON_LIGHT_PWM_COLD_PIN=3
CONFIG_COMMON_LIGHT_EVENTBUFFER_LEN=512
CONFIG_COMMON_LIGHT_MONITOR_INTERVAL=20
# CONFIG_COMMON_LIGHT_PROCESS_ALL_EVENT is not set
CONFIG_COMMON_LIGHT_CHECK_GRADIENT_INTERVAL=y
CONFIG_COMMON_LIGHT_POWER_ON_COUNT=9
CONFIG_COMMON_LIGHT_POWER_ON_INTERVAL=8000

#
# Remote Controller
#
CONFIG_COMMON_LIGHT_REMOTE_CONTROLLER_MAX_NUM=3
CONFIG_COMMON_LIGHT_REMOTE_CONTROLLER_PARING_TIMEOUT_MS=10000
CONFIG_COMMON_LIGHT_REMOTE_CONTROLLER_BIND_CNT=3
CONFIG_COMMON_LIGHT_REMOTE_CONTROLLER_UNBIND_CNT=5
CONFIG_COMMON_LIGHT_REMOTE_CONTROLLER_TIMER_INTERVAL_MS=50
CONFIG_COMMON_LIGHT_REMOTE_CONTROLLER_LIGHTNESS_LONGPRESS_STEP=100
CONFIG_COMMON_LIGHT_REMOTE_CONTROLLER_LIGHTTEMP_LONGPRESS_STEP=38
# end of Remote Controller
