#
# xjiang serial
#
CONFIG_QM_SERIAL_UART_PORT=1
CONFIG_QM_SERIAL_UART_BAUDRATE=9600
CONFIG_QM_SERIAL_UART_TX_PIN=10
CONFIG_QM_SERIAL_UART_RX_PIN=11
# CONFIG_QM_SERIAL_RTOS_SUPPORT is not set
CONFIG_QM_SERIAL_RESEND_SUPPORT=y
# CONFIG_QM_SERIAL_OTA_SUPPORT is not set
# CONFIG_QM_SERIAL_RAW_SUPPORT is not set
# CONFIG_QM_SERIAL_LOWPOWER_SUPPORT is not set
CONFIG_QM_SERIAL_HEARTBEAT_NOTIFY_SUPPORT=y
CONFIG_QM_SERIAL_PRINTF_SUPPORT=y
CONFIG_QM_SERIAL_REPORT_NOTIFY_SUPPORT=y
# CONFIG_QM_SERIAL_ONLY_REPORT_NOTIFY_SUPPORT is not set

#
# just notify report event
#
CONFIG_QM_SERIAL_EVENT_SUPPORT=y
CONFIG_QM_SERIAL_EVENT_NOTIFY_SUPPORT=y
# CONFIG_QM_SERIAL_EVENT_ONLY_NOTIFY_SUPPORT is not set

#
# just notify event
#
CONFIG_QM_SERIAL_EVENT_MAX_NUM=10
# CONFIG_QM_SERIAL_ACTION_SUPPORT is not set
CONFIG_QM_SERIAL_SEND_INTERVAL_TIMEOUT_MS=50
CONFIG_QM_SERIAL_ACK_TIMEOUT_MS=100
CONFIG_QM_SERIAL_ID_CHECK_TIMEOUT_MS=100
CONFIG_QM_SERIAL_RECV_TIMEOUT_MS=100
CONFIG_QM_SERIAL_SEND_QUEUE_NUM=20
CONFIG_QM_SERIAL_DOWN_QUEUE_NUM=20
CONFIG_QM_SERIAL_SEND_RETRY_COUNT=1
# end of xjiang serial

#
# aupu serial
#
CONFIG_AUPU_SERIAL_UART_PORT=1
CONFIG_AUPU_SERIAL_UART_BAUDRATE=9600
CONFIG_AUPU_SERIAL_UART_TX_PIN=1
CONFIG_AUPU_SERIAL_UART_RX_PIN=2
CONFIG_AUPU_SERIAL_RTOS_SUPPORT=y
CONFIG_AUPU_SERIAL_PRINTF_SUPPORT=y
CONFIG_AUPU_SERIAL_SEND_RETRY_COUNT=4
CONFIG_AUPU_SERIAL_SEND_INTERVAL_TIMEOUT_MS=15
CONFIG_AUPU_SERIAL_PROCESS_TIMEOUT_MS=200
CONFIG_AUPU_SERIAL_RECV_TIMEOUT_MS=15
CONFIG_AUPU_SERIAL_BEACON_PAIR_TIMEOUT_MS=10000
CONFIG_AUPU_SERIAL_SEND_QUEUE_NUM=20
# end of aupu serial

