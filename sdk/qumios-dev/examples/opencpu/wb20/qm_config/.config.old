#
# TLV/DTTV/TTLV
#
# CONFIG_QM_TLV_SUPPORT is not set
# CONFIG_QM_DTTV_SUPPORT is not set
CONFIG_QM_TTLV_SUPPORT=y
CONFIG_QM_TTLV_TAG_SIZE=1
CONFIG_QM_TTLV_LENGTH_SIZE=1
CONFIG_QM_TTLV_BYTES_SIZE=4
CONFIG_QM_TTLV_INT16_SUPPORT=y
CONFIG_QM_TTLV_INT32_SUPPORT=y
CONFIG_QM_TTLV_FLOAT32_SUPPORT=y
CONFIG_QM_TTLV_INT64_SUPPORT=y
CONFIG_QM_TTLV_BYTES_SUPPORT=y
# end of TLV/DTTV/TTLV

#
# mtrace
#
# CONFIG_QM_MTRACE_SUPPORT is not set
# end of mtrace

#
# TOTP
#
CONFIG_TOTP_KEY_DIGITS=6
CONFIG_TOTP_KEY_SETS=8
