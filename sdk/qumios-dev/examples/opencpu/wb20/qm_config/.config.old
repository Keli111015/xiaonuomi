
#
# apps
#

#
# generic_serial
#
CONFIG_QM_GENERIC_SERIAL_XJIANG_VERION="0.0.1"
CONFIG_QM_GENERIC_SERIAL_PLATFORM_VERION="0.0.1"
CONFIG_QM_GENERIC_SERIAL_TYPE_BAIDU=y
# CONFIG_QM_GENERIC_SERIAL_TYPE_MIIO is not set
# end of generic_serial

#
# opple serial
#
# CONFIG_OPPLE_GENERIC_SERIAL_KV_SUPPORT is not set
# end of opple serial

#
# aupu bath heater serial
#
# CONFIG_GENERIC_SERIAL_SUPPORT is not set
# end of aupu bath heater serial

#
# prodtst box
#
CONFIG_QM_PRODTST_BOX_WIFI_SUPPORT=y
# CONFIG_QM_PRODTST_BOX_4G_SUPPORT is not set
# end of prodtst box
# end of apps

#
# qumios
#

#
# qumi kernel
#
CONFIG_QM_OS_SUPPORT=y
CONFIG_QM_LOG_SUPPORT=y
CONFIG_QM_DEBUG_UART_PORT=0
CONFIG_QM_DEBUG_UART_BRAUDRATE=115200
CONFIG_QM_DEBUG_UART_TX_PIN=1
CONFIG_QM_DEBUG_UART_RX_PIN=3
CONFIG_LOG_SIMPLE=y
# CONFIG_LOG_DETAILS is not set
# CONFIG_QM_ASSERT is not set
# CONFIG_QM_LOG_PROTECT_SUPPORT is not set
# CONFIG_QM_LOG_HEX_CACHE_SUPPORT is not set
CONFIG_SOFTWARE_PLATFORM_FREERTOS=y
# CONFIG_SOFTWARE_PLATFORM_ALIOS_THINGS is not set
# CONFIG_SOFTWARE_PLATFORM_VELA is not set
# end of qumi kernel
# end of qumios

#
# hal
#

#
# soc
#
# CONFIG_QM_GPIO_SUPPORT is not set
# CONFIG_QM_RTC_SUPPORT is not set
# CONFIG_QM_PWM_SUPPORT is not set
# CONFIG_QM_UART_SUPPORT is not set
# CONFIG_QM_I2C_SUPPORT is not set
# CONFIG_QM_SPI_SUPPORT is not set
# CONFIG_QM_TIMER_SUPPORT is not set
# CONFIG_QM_ADC_SUPPORT is not set
