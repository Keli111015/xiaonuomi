# board
#
# CONFIG_BOARD_PLATFORM_7100C is not set
# CONFIG_BOARD_PLATFORM_RTL8762 is not set
# CONFIG_BOARD_PLATFORM_MHCWB6S is not set
CONFIG_MHCWB4P_MIIO_VERSION=1
CONFIG_BOARD_PLATFORM_MHCWB4P=y
# end of board
# end of board

#
# components
#

#
# qm database
#
CONFIG_QM_KV_SUPPORT=y
CONFIG_QM_KV_SYSTEM_SUPPORT=y
# CONFIG_QM_KV_DB_SUPPORT is not set
# CONFIG_QM_TS_SUPPORT is not set
# end of qm database

#
# comm base
#
# CONFIG_COMM_BASE_SUPPORT is not set
# end of comm base

#
# qm at
#
# CONFIG_QM_AT_SERVER is not set
# CONFIG_QM_AT_CLIENT is not set
# end of qm at

#
# qm ble
#
# CONFIG_QM_BLE is not set
# end of qm ble

#
# network
#
# CONFIG_QM_NETWORK_TLS_SUPPORT is not set
# end of network

#
# pppos
#
# CONFIG_QM_PPPOS_CLIENT_SUPPORT is not set
# end of pppos

#
# NTP
#
CONFIG_QM_TIME_TASK_PRIO=21
CONFIG_QM_TIME_TASK_SIZE=4096
CONFIG_QM_TIME_SYNC_TIMEOUT=21600
# end of NTP

#
# qm work
#
# CONFIG_QM_WORK_SUPPORT is not set
# end of qm work

#
# multi_button
#
CONFIG_MULTI_BUTTON_SHORT_TIMEOUT=100
CONFIG_MULTI_BUTTON_LONG_TIMEOUT=1000
CONFIG_MULTI_BUTTON_TICKS_INTERVAL=20
CONFIG_MULTI_BUTTON_DEBOUNCE_TICKS=1
# end of multi_button

#
# cli
#
# CONFIG_QM_CLI_SUPPORT is not set
# end of cli

#
# epochtime
#
# CONFIG_QM_TIME_NTP_SUPPORT is not set
CONFIG_QM_TIME_LOCAL_SUPPORT=y
# end of epochtime

#
# http
#
# CONFIG_QM_HTTPS_SUPPORT is not set
# CONFIG_HTTP_DEBUG_PRINT is not set
CONFIG_HTTPCLIENT_CHUNK_SIZE=1024
CONFIG_HTTPCLIENT_SEND_BUF_SIZE=512
# end of http

#
# IOT generic
#
CONFIG_QM_IOT_GENERIC_SUPPORT=y
# CONFIG_IOT_GENERIC_PLATFORM_ALI_SUPPORT is not set
# CONFIG_IOT_GENERIC_PLATFORM_ALI_IOT_SUPPORT is not set
CONFIG_IOT_GENERIC_PLATFORM_MI_SUPPORT=y
# CONFIG_IOT_GENERIC_PLATFORM_HARMONY_SUPPORT is not set
# CONFIG_IOT_GENERIC_PLATFORM_XJIANG_SUPPORT is not set
# CONFIG_IOT_GENERIC_PLATFORM_HONOR_SUPPORT is not set
# CONFIG_IOT_GENERIC_PLATFORM_BAIDU_SUPPORT is not set
CONFIG_IOT_GENERIC_NETWORK_WIFI_SUPPORT=y
# CONFIG_IOT_GENERIC_NETWORK_BLE_SUPPORT is not set
# CONFIG_IOT_GENERIC_NETWORK_MESH_SUPPORT is not set
CONFIG_IOT_MAP_VERSION_V2=y
CONFIG_IOT_GENERIC_EVENT_SUPPORT=y
CONFIG_IOT_GENERIC_ACTION_SUPPORT=y
# CONFIG_IOT_GENERIC_RAWDATA_SUPPORT is not set
# end of IOT generic

#
# xjiang cloud
#
# CONFIG_OTA_SUPPORT is not set
# CONFIG_DYN_REG_SUPPORT is not set
# end of xjiang cloud

#
# xjiang serial
#
CONFIG_QM_SERIAL_UART_PORT=1
CONFIG_QM_SERIAL_UART_BAUDRATE=9600
CONFIG_QM_SERIAL_UART_TX_PIN=1
CONFIG_QM_SERIAL_UART_RX_PIN=2
# CONFIG_QM_SERIAL_RTOS_SUPPORT is not set
# CONFIG_QM_SERIAL_RESEND_SUPPORT is not set
# CONFIG_QM_SERIAL_OTA_SUPPORT is not set
# CONFIG_QM_SERIAL_RAW_SUPPORT is not set
# CONFIG_QM_SERIAL_LOWPOWER_SUPPORT is not set
# CONFIG_QM_SERIAL_HEARTBEAT_NOTIFY_SUPPORT is not set
# CONFIG_QM_SERIAL_PRINTF_SUPPORT is not set
CONFIG_QM_SERIAL_REPORT_NOTIFY_SUPPORT=y
# CONFIG_QM_SERIAL_ONLY_REPORT_NOTIFY_SUPPORT is not set

#
# just notify report event
#
# CONFIG_QM_SERIAL_EVENT_SUPPORT is not set
# CONFIG_QM_SERIAL_ACTION_SUPPORT is not set
CONFIG_QM_SERIAL_SEND_INTERVAL_TIMEOUT_MS=200
CONFIG_QM_SERIAL_ACK_TIMEOUT_MS=500
CONFIG_QM_SERIAL_ID_CHECK_TIMEOUT_MS=500
CONFIG_QM_SERIAL_RECV_TIMEOUT_MS=500
CONFIG_QM_SERIAL_SEND_QUEUE_NUM=20
CONFIG_QM_SERIAL_DOWN_QUEUE_NUM=20
CONFIG_QM_SERIAL_SEND_RETRY_COUNT=1
# end of xjiang serial

#
# aupu serial
#
CONFIG_AUPU_SERIAL_UART_PORT=1
CONFIG_AUPU_SERIAL_UART_BAUDRATE=9600
CONFIG_AUPU_SERIAL_UART_TX_PIN=1
CONFIG_AUPU_SERIAL_UART_RX_PIN=2
# CONFIG_AUPU_SERIAL_RTOS_SUPPORT is not set
# CONFIG_AUPU_SERIAL_PRINTF_SUPPORT is not set
CONFIG_AUPU_SERIAL_SEND_RETRY_COUNT=4
CONFIG_AUPU_SERIAL_SEND_INTERVAL_TIMEOUT_MS=15
CONFIG_AUPU_SERIAL_PROCESS_TIMEOUT_MS=200
CONFIG_AUPU_SERIAL_RECV_TIMEOUT_MS=15
CONFIG_AUPU_SERIAL_BEACON_PAIR_TIMEOUT_MS=10000
CONFIG_AUPU_SERIAL_SEND_QUEUE_NUM=20
# end of aupu serial

