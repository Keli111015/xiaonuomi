
#
# apps
#

#
# generic_serial
#
CONFIG_QM_GENERIC_SERIAL_TYPE_BAIDU=y
# CONFIG_QM_GENERIC_SERIAL_TYPE_MIIO is not set
# end of generic_serial

#
# opple serial
#
# CONFIG_OPPLE_GENERIC_SERIAL_KV_SUPPORT is not set
# end of opple serial

#
# aupu bath heater serial
#
# CONFIG_GENERIC_SERIAL_SUPPORT is not set
# end of aupu bath heater serial

#
# prodtst box
#
CONFIG_QM_PRODTST_BOX_WIFI_SUPPORT=y
# CONFIG_QM_PRODTST_BOX_4G_SUPPORT is not set
# end of prodtst box
# end of apps

#
# qumios
#

#
# qumi kernel
#
CONFIG_QM_OS_SUPPORT=y
CONFIG_QM_LOG_SUPPORT=y
CONFIG_QM_DEBUG_UART_PORT=0
CONFIG_QM_DEBUG_UART_BRAUDRATE=115200
CONFIG_QM_DEBUG_UART_TX_PIN=1
CONFIG_QM_DEBUG_UART_RX_PIN=3
CONFIG_LOG_SIMPLE=y
# CONFIG_LOG_DETAILS is not set
# CONFIG_QM_ASSERT is not set
# CONFIG_QM_LOG_PROTECT_SUPPORT is not set
# CONFIG_QM_LOG_HEX_CACHE_SUPPORT is not set
CONFIG_SOFTWARE_PLATFORM_FREERTOS=y
# CONFIG_SOFTWARE_PLATFORM_ALIOS_THINGS is not set
# CONFIG_SOFTWARE_PLATFORM_VELA is not set
# end of qumi kernel
# end of qumios

#
# hal
#

#
# soc
#
CONFIG_QM_FLASH_SUPPORT=y

#
# flash config
#
CONFIG_QM_FLASH_BLOCK_SIZE=4096
CONFIG_QM_FLASH_WRITE_GRAN=8
# CONFIG_QM_FLASH_PARTITION_BOOTLOADER_SUPPORT is not set
# CONFIG_QM_FLASH_PARTITION_APPLICATION_SUPPORT is not set
# CONFIG_QM_FLASH_PARTITION_OTA_TEMP_SUPPORT is not set
# CONFIG_QM_FLASH_PARTITION_PARAMETER_1_SUPPORT is not set
CONFIG_QM_FLASH_PARTITION_PARAMETER_2_SUPPORT=y
CONFIG_QM_FLASH_PARAMETER_2_START_ADDR=0
CONFIG_QM_FLASH_PARAMETER_2_SIZE=0x4000
# CONFIG_QM_FLASH_PARTITION_PARAMETER_3_SUPPORT is not set
# CONFIG_QM_FLASH_PARTITION_PARAMETER_4_SUPPORT is not set
# CONFIG_QM_FLASH_PARTITION_SPIFFS_SUPPORT is not set
# CONFIG_QM_FLASH_PARTITION_CUSTOM_1_SUPPORT is not set
# CONFIG_QM_FLASH_PARTITION_CUSTOM_2_SUPPORT is not set
# CONFIG_QM_FLASH_PARTITION_2ND_BOOT_SUPPORT is not set
# CONFIG_QM_FLASH_PARTITION_OTA_SUB_SUPPORT is not set
# end of flash config
# end of soc

#
# wifi
#
# CONFIG_QM_WIFI_SUPPORT is not set
# end of wifi
# end of hal

#
# drivers
#

#
# board
#

#
# board
#
CONFIG_BOARD_PLATFORM_7100C=y
# CONFIG_BOARD_PLATFORM_RTL8762 is not set
# CONFIG_BOARD_PLATFORM_ESP32C3 is not set
# end of board
# end of board

#
# components
#

#
# qm database
#
CONFIG_QM_KV_SUPPORT=y
# CONFIG_QM_KV_SYSTEM_SUPPORT is not set
CONFIG_QM_KV_DB_SUPPORT=y
CONFIG_QM_KV_DB_FLASH_PARTITION_INFO="kv,0,8192"

#
# The config format is as follows <name>,<offset>,<size>, the size must more than twice flash sector size
#
# CONFIG_QM_TS_SUPPORT is not set
# CONFIG_QM_FLASHDB_INTERNAL_FLASH is not set
CONFIG_QM_FLASHDB_EXTERNAL_FLASH=y
CONFIG_QM_FLASHDB_EXTERNAL_FLASH_SPI=y
# end of qm database

#
# qm at
#
CONFIG_QM_AT_SERVER=y
CONFIG_QM_AT_SERVER_MAX_NUM=3
CONFIG_QM_AT_SERVER_TASK_SIZE=2048
CONFIG_QM_AT_SERVER_TASK_PRIO=20
# CONFIG_QM_AT_CLIENT is not set
CONFIG_QM_AT_CMD_TABLE_MAX_NUM=3
# CONFIG_QM_AT_PRINT_RAW_CMD is not set
CONFIG_QM_AT_CMD_NAME_MAX_LEN=16
CONFIG_QM_AT_CMD_MAX_LEN=32
# end of qm at

#
# qm ble
#
# CONFIG_QM_BLE is not set
# end of qm ble

#
# network
#
# CONFIG_QM_NETWORK_TLS_SUPPORT is not set
# end of network

#
# pppos
#
# CONFIG_QM_PPPOS_CLIENT_SUPPORT is not set
# end of pppos

#
# NTP
#
CONFIG_QM_TIME_TASK_PRIO=21
CONFIG_QM_TIME_TASK_SIZE=4096
CONFIG_QM_TIME_SYNC_TIMEOUT=21600
# end of NTP

#
# qm work
#
# CONFIG_QM_WORK_SUPPORT is not set
# end of qm work

#
# multi_button
#
CONFIG_MULTI_BUTTON_SHORT_TIMEOUT=100
CONFIG_MULTI_BUTTON_LONG_TIMEOUT=1000
CONFIG_MULTI_BUTTON_TICKS_INTERVAL=20
CONFIG_MULTI_BUTTON_DEBOUNCE_TICKS=1
# end of multi_button

#
# cli
#
CONFIG_QM_CLI_SUPPORT=y
CONFIG_QM_CLI_MINI_SIZE=y
# CONFIG_QM_CLI_BIG_SIZE is not set
CONFIG_QM_CLI_TASK_SIZE=2048
CONFIG_QM_CLI_TASK_PRIO=20
CONFIG_QM_CLI_MAX_COMMANDS=32
CONFIG_QM_CLI_MAX_ARG_NUM=8
CONFIG_QM_CLI_MAX_ONCECMD_NUM=1
CONFIG_QM_CLI_INBUF_SIZE=256
# end of cli

#
# epochtime
#
CONFIG_QM_TIME_NTP_SUPPORT=y
# CONFIG_QM_TIME_LOCAL_SUPPORT is not set
CONFIG_QM_ALI_NTP_SUPPORT=y
CONFIG_QM_NTP_PORT=123
# CONFIG_QM_TENCENT_NTP_SUPPORT is not set
# end of epochtime

#
# http
#
# CONFIG_QM_HTTPS_SUPPORT is not set
CONFIG_HTTP_DEBUG_PRINT=y
CONFIG_HTTPCLIENT_CHUNK_SIZE=1024
CONFIG_HTTPCLIENT_SEND_BUF_SIZE=512
# end of http

#
# IOT generic
#
# CONFIG_QM_IOT_GENERIC_SUPPORT is not set
# end of IOT generic

#
# xjiang cloud
#
CONFIG_OTA_SUPPORT=y
CONFIG_DYN_REG_SUPPORT=y
# end of xjiang cloud

#
# xjiang serial
#
CONFIG_QM_SERIAL_UART_PORT=1
CONFIG_QM_SERIAL_UART_BAUDRATE=9600
CONFIG_QM_SERIAL_UART_TX_PIN=1
CONFIG_QM_SERIAL_UART_RX_PIN=2
CONFIG_QM_SERIAL_RTOS_SUPPORT=y
CONFIG_QM_SERIAL_RESEND_SUPPORT=y
CONFIG_QM_SERIAL_OTA_SUPPORT=y
CONFIG_QM_SERIAL_RAW_SUPPORT=y
CONFIG_QM_SERIAL_LOWPOWER_SUPPORT=y
CONFIG_QM_SERIAL_HEARTBEAT_NOTIFY_SUPPORT=y
CONFIG_QM_SERIAL_PRINTF_SUPPORT=y
CONFIG_QM_SERIAL_REPORT_NOTIFY_SUPPORT=y
# CONFIG_QM_SERIAL_ONLY_REPORT_NOTIFY_SUPPORT is not set

#
# just notify report event
#
CONFIG_QM_SERIAL_EVENT_SUPPORT=y
CONFIG_QM_SERIAL_EVENT_NOTIFY_SUPPORT=y
# CONFIG_QM_SERIAL_EVENT_ONLY_NOTIFY_SUPPORT is not set

#
# just notify event
#
CONFIG_QM_SERIAL_EVENT_MAX_NUM=10
CONFIG_QM_SERIAL_ACTION_SUPPORT=y
CONFIG_QM_SERIAL_SEND_INTERVAL_TIMEOUT_MS=200
CONFIG_QM_SERIAL_ACK_TIMEOUT_MS=500
CONFIG_QM_SERIAL_ID_CHECK_TIMEOUT_MS=500
CONFIG_QM_SERIAL_RECV_TIMEOUT_MS=500
CONFIG_QM_SERIAL_SEND_QUEUE_NUM=20
CONFIG_QM_SERIAL_DOWN_QUEUE_NUM=20
CONFIG_QM_SERIAL_SEND_RETRY_COUNT=1
# end of xjiang serial

#
# aupu serial
#
CONFIG_AUPU_SERIAL_UART_PORT=1
CONFIG_AUPU_SERIAL_UART_BAUDRATE=9600
CONFIG_AUPU_SERIAL_UART_TX_PIN=1
CONFIG_AUPU_SERIAL_UART_RX_PIN=2
CONFIG_AUPU_SERIAL_RTOS_SUPPORT=y
CONFIG_AUPU_SERIAL_PRINTF_SUPPORT=y
CONFIG_AUPU_SERIAL_SEND_RETRY_COUNT=4
CONFIG_AUPU_SERIAL_SEND_INTERVAL_TIMEOUT_MS=15
CONFIG_AUPU_SERIAL_PROCESS_TIMEOUT_MS=200
CONFIG_AUPU_SERIAL_RECV_TIMEOUT_MS=15
CONFIG_AUPU_SERIAL_BEACON_PAIR_TIMEOUT_MS=10000
CONFIG_AUPU_SERIAL_SEND_QUEUE_NUM=20
# end of aupu serial

#
# Prodtst_Client
#
# CONFIG_LOG_ON_OFF is not set
# CONFIG_PRODTST_CLIENT_CHIP_WB60 is not set
CONFIG_PRODTST_CLIENT_CHIP_WB28=y
# CONFIG_PRODTST_CLIENT_CHIP_WB20 is not set
# CONFIG_PRODTST_CLIENT_CHIP_W70 is not set
CONFIG_PRODTST_CLIENT_RECV_BUFF_LEN=256
# CONFIG_PRODTST_CLIENT_UART_SUPPORT is not set
# CONFIG_PRODTST_CLIENT_BLE_SUPPORT is not set
# end of Prodtst_Client

#
# Offline_Voice
#
# CONFIG_QM_OFFLINE_VOICE_SUPPORT is not set
# end of Offline_Voice

#
# opple serial
#
# CONFIG_OPPLE_SERIAL_SUPPORT is not set
# end of opple serial

#
# sfud
#
CONFIG_SFUD_SUPPORT=y
# CONFIG_SFUD_DEBUG_ON is not set
CONFIG_SFUD_USING_SFDP=y
# CONFIG_SFUD_USING_FLASH_INFO_TABLE is not set
# CONFIG_SFUD_USING_QSPI is not set
CONFIG_SFUD_SPI_PORT=1
CONFIG_SFUD_SPI_CLOCK_SPEED=8000000
CONFIG_SFUD_SPI_MISO_PIN=64
CONFIG_SFUD_SPI_MOSI_PIN=64
CONFIG_SFUD_SPI_SCLK_PIN=64
CONFIG_SFUD_SPI_CS_PIN=64
CONFIG_SFUD_RETRY_DELAY_US=100
CONFIG_SFUD_ERROR_RETRY_TIME=30
CONFIG_SFUD_DEVICE_NAME="XJ_SPI_FLASH"
CONFIG_SFUD_SPI_NAME="EXT_SPI1"
# end of sfud
# end of components

#
# utility
#

#
# kv
#
# end of kv

#
# TLV/DTTV/TTLV
#
CONFIG_QM_TLV_SUPPORT=y
CONFIG_QM_TLV_TAG_SIZE=1
CONFIG_QM_TLV_LENGTH_SIZE=1
CONFIG_QM_TLV_BYTES_SIZE=4
CONFIG_QM_TLV_INT16_SUPPORT=y
CONFIG_QM_TLV_INT32_SUPPORT=y
CONFIG_QM_TLV_FLOAT32_SUPPORT=y
# CONFIG_QM_TLV_INT64_SUPPORT is not set
CONFIG_QM_TLV_BYTES_SUPPORT=y
CONFIG_QM_DTTV_SUPPORT=y
CONFIG_QM_DTTV_FORCE_UPDATE_SUPPORT=y
CONFIG_QM_DTTV_TAG_SIZE=1
CONFIG_QM_DTTV_LENGTH_SIZE=1
CONFIG_QM_DTTV_BYTES_SIZE=4
CONFIG_QM_DTTV_INT16_SUPPORT=y
CONFIG_QM_DTTV_INT32_SUPPORT=y
CONFIG_QM_DTTV_FLOAT32_SUPPORT=y
# CONFIG_QM_DTTV_INT64_SUPPORT is not set
CONFIG_QM_DTTV_BYTES_SUPPORT=y
CONFIG_QM_TTLV_SUPPORT=y
CONFIG_QM_TTLV_TAG_SIZE=1
CONFIG_QM_TTLV_LENGTH_SIZE=1
CONFIG_QM_TTLV_BYTES_SIZE=4
CONFIG_QM_TTLV_INT16_SUPPORT=y
CONFIG_QM_TTLV_INT32_SUPPORT=y
CONFIG_QM_TTLV_FLOAT32_SUPPORT=y
# CONFIG_QM_TTLV_INT64_SUPPORT is not set
CONFIG_QM_TTLV_BYTES_SUPPORT=y
# end of TLV/DTTV/TTLV

#
# mtrace
#
# CONFIG_QM_MTRACE_SUPPORT is not set
# end of mtrace

#
# TOTP
#
CONFIG_TOTP_KEY_DIGITS=6
CONFIG_TOTP_KEY_SETS=8
# end of TOTP

#
# memory
#
# end of memory

