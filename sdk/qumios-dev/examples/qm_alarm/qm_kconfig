        default n

    if QM_ALARM_EXAMPLE_CONFIG

        config QM_ALARM_EXAMPLE_PRODUCT_ID
            int "alarm example product id"
            default 0

        config QM_ALARM_EXAMPLE_PRODUCT_SECRET
            string "alarm example product secret"
            default ""

        config QM_ALARM_EXAMPLE_SN
            string "alarm example serial number"
            default "qm-alarm-example-device"

        config QM_ALARM_EXAMPLE_VERSION
            string "alarm example version"
            default "1.0.0"

        config QM_ALARM_EXAMPLE_DYNREG_HOST
            string "alarm example dynreg host override"
            default ""

        config QM_ALARM_EXAMPLE_ADV_CID
            string "alarm example BLE provision adv cid"
            default ""

        config QM_ALARM_EXAMPLE_WIFI_SSID
            string "alarm example Wi-Fi ssid"
            default ""

        config QM_ALARM_EXAMPLE_WIFI_PASSWORD
            string "alarm example Wi-Fi password"
            default ""

        config QM_ALARM_EXAMPLE_WIFI_RETRY_MAX
            int "alarm example Wi-Fi retry max"
            default 10

        config QM_ALARM_EXAMPLE_NAME
            string "alarm example name"
