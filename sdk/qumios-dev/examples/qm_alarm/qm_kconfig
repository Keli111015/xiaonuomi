        config QM_ALARM_EXAMPLE_SNOOZE_INTERVAL_MIN
            int "alarm example snooze interval minutes"
            default 5
            range 1 30

        config QM_ALARM_EXAMPLE_SNOOZE_MAX_COUNT
            int "alarm example snooze max count"
            default 3
            range 1 10

        config QM_ALARM_EXAMPLE_ENABLE_CLOUD_REPORT
