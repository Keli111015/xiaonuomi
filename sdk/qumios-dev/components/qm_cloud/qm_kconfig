menu "qm cloud"

    config QM_CLOUD_SUPPORT
        bool "qm cloud"
        default n
        depends on QM_OS_SUPPORT
        depends on QM_OS_TASK_SUPPORT
        depends on QM_OS_MUTEX_SUPPORT
        depends on QM_OS_SEM_SUPPORT
        select QM_WORK_SUPPORT
        select QM_TIME_SUPPORT
        select QM_HTTP_CLIENT_SUPPORT
        select QM_KV_SUPPORT

    if QM_CLOUD_SUPPORT

        config QM_IOT_MQTT_SUPPORT
            bool "mqtt support"
            default y
            select MQTT_TLS_SUPPORT

        config QM_IOT_SPEC_SUPPORT
            bool "qm spec support"
            default n

        config QM_IOT_PUB_SUPPORT
            bool "pub support"
            default y

        config QM_IOT_AUTHCODE_SUPPORT
            bool "authcode support"
            default n

        config QM_IOT_AUTHCODE_MAX_LEN
            int "authcode max len"
            default 64
            range 16 64

        config QM_IOT_DYNREG_SUPPORT
            bool "dynreg support"
            default y
            select QM_HTTP_CLIENT_SUPPORT

        config QM_IOT_DEV_INFO_SUPPORT
            bool "devinfo mqtt report support"
            default y

        config QM_IOT_NTP_SUPPORT
            bool "ntp submodule support"
            default y

        config QM_IOT_WEATHER_SUPPORT
            bool "weather submodule support"
            default y

        config QM_IOT_DEVMNT_SUPPORT
            bool "iot dev manger support"
            default y

        config QM_IOT_OTA_SUPPORT
            bool "ota support"
            default n
            select QM_WORK_SUPPORT
        if QM_IOT_OTA_SUPPORT
            config QM_IOT_SLIENT_OTA_SUPPORT
                bool "silent ota support"
                default y
        endif
        
    config QM_IOT_SN_KV_SUPPORT
        bool "sn kv support"
        default n

    config QM_IOT_SN_MAX_LEN
        int "iot did max len (unit:byte)"
        default 32
        range 16 64

    config QM_IOT_DID_MAX_LEN
        int "iot did max len (unit:byte)"
        default 16
        range 16 64

    config QM_IOT_MQTT_HOST_MAX_LEN
        int "iot mqtt host max len (unit:byte)"
        default 64
        range 32 128

    config QM_IOT_CRT_MAX_LEN
        int "iot Certificate chain max len (unit:byte)"
        default 2048
        range 1024 4096

    config QM_IOT_OTA_CRT_MAX_LEN
        int "iot ota Certificate chain max len (unit:byte)"
        default 384
        range 256 4096
        

    config QM_IOT_MQTT_READ_MSGLEN
        int "iot mqtt read message max len (unit:byte)"
        default 8144
        range 2048 65536

    config QM_IOT_STREAMS_BLOCK_SIZE
        int "iot ota stream block size (unit:byte)"
        default 2048
        range 256 4096

    config QM_CLOUD_LOG_CONFIG
        bool "Enable qm_cloud log category configuration"
        default n
        help
            Enable category-level logging for all qm_cloud submodules.
            When disabled, only error and lifecycle logs are enabled.

    if QM_CLOUD_LOG_CONFIG

        config QM_CLOUD_LOG_ERROR
            bool "qm_cloud error logs"
            default y

        config QM_CLOUD_LOG_LIFECYCLE
            bool "qm_cloud lifecycle logs"
            default y

        config QM_CLOUD_LOG_CONTROL
            bool "qm_cloud control logs"
            default n

        config QM_CLOUD_LOG_UPLINK
            bool "qm_cloud uplink logs"
            default n

        config QM_CLOUD_LOG_DOWNLINK
            bool "qm_cloud downlink logs"
            default n

        config QM_CLOUD_LOG_PAYLOAD
            bool "qm_cloud payload logs"
            default n

        config QM_CLOUD_LOG_AUTH
            bool "qm_cloud authentication logs"
            default n

        config QM_CLOUD_LOG_OTA
            bool "qm_cloud OTA logs"
            default n

        config QM_CLOUD_LOG_SUBDEV
            bool "qm_cloud subdevice logs"
            default n

        config QM_CLOUD_LOG_SERVICE
            bool "qm_cloud service logs"
            default n

        config QM_CLOUD_LOG_STATS
            bool "qm_cloud statistics logs"
            default n

    endif

    endif
    
endmenu
