menu "qm audio"

config QM_AUDIO_SUPPORT
    bool "qm audio support"
    default n
    depends on QM_OS_SUPPORT
    depends on QM_OS_TASK_SUPPORT
    depends on QM_OS_MUTEX_SUPPORT
    depends on QM_OS_SEM_SUPPORT
    depends on QM_OS_QUEUE_SUPPORT
    help
        Enable the audio control, service, pipeline, and PCM engine interfaces.
        qm_audio owns a resident event task for its Control command and
        lifecycle path, so it requires an RTOS task and queue.

if QM_AUDIO_SUPPORT

menu "qm audio device"

choice
    prompt "qm audio platform device"
    default QM_AUDIO_DEVICE_GX8006

config QM_AUDIO_DEVICE_GX8006
    bool "GX8006 UART Opus device (ESP32-S3)"
    depends on QM_UART_SUPPORT
    depends on QM_GPIO_SUPPORT
    depends on QM_OS_TASK_SUPPORT
    depends on QM_OS_MUTEX_SUPPORT
    depends on QM_OS_SEM_SUPPORT
    select QM_GX8006_SUPPORT
    help
        Select the ESP32-S3 GX8006 UART Opus device binding. This selection
        also enables the underlying GX8006 protocol driver.

config QM_AUDIO_DEVICE_VB701N
    bool "VB701N UART PCM device (ESP32-S3)"
    depends on QM_UART_SUPPORT
    depends on QM_GPIO_SUPPORT
    depends on QM_OS_MUTEX_SUPPORT
    depends on QM_OS_SEM_SUPPORT
    select QM_VB701N_SUPPORT
    help
        Select the ESP32-S3 VB701N UART PCM device binding. Capture is PULL.
        This selection also enables the underlying VB701N protocol driver.

endchoice

if QM_AUDIO_DEVICE_GX8006

source "${QDF_PATH}/drivers/GX8006/qm_kconfig"

endif

if QM_AUDIO_DEVICE_VB701N

source "${QDF_PATH}/drivers/VB701N/qm_kconfig"

endif

endmenu

endif

config QM_AUDIO_SERVICE_MAX_SESSIONS
    int "qm audio maximum service sessions"
    range 1 32
    default 8
    depends on QM_AUDIO_SUPPORT

config QM_AUDIO_CONTROL_MAX_OPERATIONS
    int "qm audio maximum control operations"
    range 1 32
    default 8
    depends on QM_AUDIO_SUPPORT

config QM_AUDIO_MAX_SUBSCRIBERS
    int "qm audio event subscribers"
    range 1 16
    default 8
    depends on QM_AUDIO_SUPPORT

config QM_AUDIO_CONTROL_OPERATION_TIMEOUT_MS
    int "qm audio control operation transition timeout"
    range 1 60000
    default 1000
    depends on QM_AUDIO_SUPPORT
    help
        Bounded wait used internally while Control coordinates a preserving
        pause or waits for normal device-output completion after Pipeline EOF.

config QM_AUDIO_CLOUD_SUPPORT
    bool "qm audio cloud player control"
    default n
    depends on QM_AUDIO_SUPPORT
    depends on QM_CLOUD_SUPPORT
    depends on QM_OS_QUEUE_SUPPORT
    depends on QM_OS_SEM_SUPPORT
    depends on QM_OS_TASK_SUPPORT
    depends on !QM_PLAYER_CLOUD_SUPPORT
    select CJSON_LIB
    help
        Enable the optional qm_audio cloud adapter. It registers the default
        player method through qm_cloud and translates typed player commands
        into qm_audio_control operations. This must not be enabled together
        with the legacy qm_player cloud adapter because both use player.

if QM_AUDIO_CLOUD_SUPPORT

config QM_AUDIO_CLOUD_QUEUE_LEN
    int "qm audio cloud work queue length"
    range 2 32
    default 6
    help
        Bounds queued cloud downlink commands. Control status is coalesced per
        operation and does not consume this queue.

config QM_AUDIO_CLOUD_MAX_OPERATIONS
    int "qm audio cloud maximum owned operations"
    range 1 16
    default 4
    help
        Bound cloud msg_id to Control operation mappings. This must not exceed
        the Control operation capacity configured by the application.

config QM_AUDIO_CLOUD_TASK_STACK_SIZE
    int "qm audio cloud task stack size"
    range 2048 16384
    default 4096

config QM_AUDIO_CLOUD_TASK_PRIORITY
    int "qm audio cloud task priority"
    range 1 60
    default 20

endif

config QM_AUDIO_CAPTURE_SUPPORT
    bool "qm audio independent capture support"
    default y
    depends on QM_AUDIO_SUPPORT
    depends on QM_OS_TASK_SUPPORT
    depends on QM_OS_MUTEX_SUPPORT
    depends on QM_OS_SEM_SUPPORT

choice
    prompt "qm audio capture adapter mode"
    depends on QM_AUDIO_CAPTURE_SUPPORT
    default QM_AUDIO_CAPTURE_MODE_PUSH
    help
        Select exactly one capture integration method at build time. This
        selection is independent of the MCU and device format capabilities.

config QM_AUDIO_CAPTURE_MODE_PULL
    bool "Pull capture through device read"
    help
        Capture owns a reader task calling qm_audio_device_capture_read() for
        PCM blocks or complete encoded packets from the device adapter.

config QM_AUDIO_CAPTURE_MODE_PUSH
    bool "Push capture through component feed"
    help
        A capture source task calls qm_audio_capture_feed(input, result).
        Audio data and terminal source errors use the same component entry.

endchoice

config QM_AUDIO_CAPTURE_QUEUE_LEN
    int "qm audio capture queue length"
    range 1 64
    default 4
    depends on QM_AUDIO_CAPTURE_SUPPORT

config QM_AUDIO_CAPTURE_MAX_SUBSCRIBERS
    int "qm audio maximum capture subscribers"
    range 1 16
    default 4
    depends on QM_AUDIO_CAPTURE_SUPPORT

config QM_AUDIO_CAPTURE_FRAME_BYTES
    int "qm audio capture frame bytes"
    range 1 8192
    default 640
    depends on QM_AUDIO_CAPTURE_SUPPORT

config QM_AUDIO_CAPTURE_TASK_STACK_SIZE
    int "qm audio capture reader task stack size"
    range 1024 16384
    default 4096
    depends on QM_AUDIO_CAPTURE_SUPPORT

config QM_AUDIO_CAPTURE_TASK_PRIORITY
    int "qm audio capture reader task priority"
    range 1 60
    default 20
    depends on QM_AUDIO_CAPTURE_SUPPORT

config QM_AUDIO_CAPTURE_CALLBACK_TASK_STACK_SIZE
    int "qm audio capture callback task stack size"
    range 1024 16384
    default 3072
    depends on QM_AUDIO_CAPTURE_SUPPORT

config QM_AUDIO_CAPTURE_CALLBACK_TASK_PRIORITY
    int "qm audio capture callback task priority"
    range 1 60
    default 20
    depends on QM_AUDIO_CAPTURE_SUPPORT

config QM_AUDIO_CAPTURE_STOP_TIMEOUT_MS
    int "qm audio capture unsubscribe timeout"
    range 1 60000
    default 1000
    depends on QM_AUDIO_CAPTURE_SUPPORT
    help
        Bounds unsubscribe waits for receiver/callback and device quiescence.
        Keep the handle and retry when cleanup fails or times out.

config QM_AUDIO_ENGINE_STOP_TIMEOUT_MS
    int "qm audio engine stop timeout"
    range 1 60000
    default 1000
    depends on QM_AUDIO_SUPPORT

config QM_AUDIO_ENGINE_RENDER_QUEUE_LEN
    int "qm audio render PCM queue length"
    range 1 64
    default 8
    depends on QM_AUDIO_SUPPORT
    help
        Maximum number of copied PCM blocks waiting for the single Engine
        render worker. This is bounded backpressure for all output producers.

config QM_AUDIO_ENGINE_RENDER_BLOCK_BYTES
    int "qm audio render byte/PCM block limit"
    range 64 65536
    default 2048
    depends on QM_AUDIO_SUPPORT
    help
        Maximum copied bytes in one PCM or encoded-byte queue item. Larger
        writes accept a frame-aligned prefix. Native packets remain atomic
        and are bounded by the fixed output profile's max_packet_bytes.

config QM_AUDIO_ENGINE_RENDER_TASK_STACK_SIZE
    int "qm audio render task stack size"
    range 2048 16384
    default 4096
    depends on QM_AUDIO_SUPPORT

config QM_AUDIO_ENGINE_RENDER_TASK_PRIORITY
    int "qm audio render task priority"
    range 1 60
    default 5
    depends on QM_AUDIO_SUPPORT

config QM_AUDIO_ENGINE_RENDER_WRITE_TIMEOUT_MS
    int "qm audio render backend write timeout"
    range 1 60000
    default 1000
    depends on QM_AUDIO_SUPPORT
    help
        Finite bound passed by the render worker to one platform playback_write
        call. Backends must also honor playback_abort while a write is pending.

config QM_AUDIO_CONTROL_SOURCE_TASK_STACK_SIZE
    int "qm audio source task stack size"
    range 2048 65536
    default 4096
    depends on QM_AUDIO_SUPPORT
    help
        Stack size for the shared source execution slot. Workers perform source I/O, decode
        submission, and PCM submission for every Control on the audio instance.
        A route that decodes and re-encodes runs the codec calls on this slot; the platform
        codec port requires far more than the I/O-only default, so size it for the heaviest
        route the instance admits.

config QM_AUDIO_CONTROL_SOURCE_TASK_PRIORITY
    int "qm audio source task priority"
    range 1 60
    default 5
    depends on QM_AUDIO_SUPPORT

config QM_AUDIO_CONTROL_EVENT_QUEUE_LEN
    int "qm audio control event queue length"
    range 2 128
    default 16
    depends on QM_AUDIO_SUPPORT
    help
        Queue of the shared audio-instance event task. Commands, lower-layer
        facts, and public notifications share this queue. Choose a capacity
        appropriate for the instance's command burst and callback load.

config QM_AUDIO_CONTROL_EVENT_TASK_STACK_SIZE
    int "qm audio control event task stack size"
    range 2048 16384
    default 4096
    depends on QM_AUDIO_SUPPORT
    help
        Stack size for the shared audio-instance event task, which executes control
        commands and dispatches normalized callbacks in one serialized context.

config QM_AUDIO_CONTROL_EVENT_TASK_PRIORITY
    int "qm audio control event task priority"
    range 1 60
    default 10
    depends on QM_AUDIO_SUPPORT
    help
        Priority of the shared audio-instance event task. It must stay responsive
        for play/pause/stop while lower than hard real-time audio workers.

config QM_AUDIO_EVENT_PENDING_MAX
    int "qm audio pending lower-event slots"
    range 4 32
    default 8
    depends on QM_AUDIO_SUPPORT
    help
        Capacity of the Service event FIFO. Pipeline facts are retained in
        each operation and never wait for this FIFO. Only the event task
        projects these facts. Producers wait for space when full; the event
        task processes the oldest fact to make room for its own posts.

config QM_AUDIO_CONTROL_PUSH_BUFFER_BYTES
    int "qm audio push source buffer bytes"
    range 1024 262144
    default 16384
    depends on QM_AUDIO_SUPPORT
    help
        Capacity of each Control PUSH operation's bounded input ring. The
        buffer is used by protocol adapters for encoded or PCM stream ingress.

config QM_AUDIO_PIPELINE_CHUNK_BYTES
    int "qm audio pipeline source chunk bytes"
    range 256 8192
    default 1024
    depends on QM_AUDIO_SUPPORT

config QM_AUDIO_PIPELINE_READ_TIMEOUT_MS
    int "qm audio pipeline source read timeout"
    range 1 60000
    default 1000
    depends on QM_AUDIO_SUPPORT

config QM_AUDIO_DECODER_SUPPORT
    bool "qm audio decoder"
    default n
    depends on QM_AUDIO_SUPPORT
    help
        Enable compressed-input decoding through a platform codec provider
        (adapter/qm_audio_codec.h named functions). The linked platform must
        provide the implementation; leave disabled when every input is already
        negotiated PCM or when the target has no decoder adapter.

config QM_AUDIO_ENCODER_SUPPORT
    bool "qm audio encoder"
    default n
    depends on QM_AUDIO_SUPPORT
    help
        Enable PCM-to-packet encoding in Pipeline. The platform supplies
        adapter/qm_audio_codec.h. Required for PCM/MP3 playback to GX8006;
        compatible Opus passthrough does not require a software encoder.

config QM_AUDIO_SOURCE_FILE_SUPPORT
    bool "qm audio built-in file source"
    default y
    depends on QM_AUDIO_SUPPORT
    depends on QM_FS_SUPPORT
    help
        Enable the built-in local file source, which reads a file path through
        qm_fs directly inside the Pipeline. Disable it only when the target
        platform has no qm_fs adapter and local file playback is not required.

config QM_AUDIO_SOURCE_URI_SUPPORT
    bool "qm audio built-in HTTP URI source"
    default n
    depends on QM_AUDIO_SUPPORT
    depends on QM_HTTP_CLIENT_SUPPORT
    help
        Enable the built-in HTTP/HTTPS URI source, which streams a network URL
        through qm_http_client directly inside the Pipeline.

endmenu
